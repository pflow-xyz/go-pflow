load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "stochastic",
    srcs = [
        "compiled.go",
        "guard.go",
        "likelihood.go",
        "portable.go",
        "schedule.go",
        "sde.go",
        "solve.go",
        "stochastic.go",
        "supply.go",
    ],
    importpath = "github.com/pflow-xyz/go-pflow/stochastic",
    visibility = ["//visibility:public"],
    deps = [
        "//learn",
        "//metamodel",
        "//petri",
        "//reachability",
        "//solver",
    ],
)

go_test(
    name = "stochastic_test",
    srcs = [
        "compiled_test.go",
        "consistency_test.go",
        "contention_test.go",
        "delay_test.go",
        "gating_test.go",
        "kinetic_test.go",
        "likelihood_test.go",
        "model_schedule_test.go",
        "parity_test.go",
        "portable_parity_test.go",
        "portable_test.go",
        "schedule_test.go",
        "sde_test.go",
        "solve_test.go",
        "stages_test.go",
        "stochastic_test.go",
        "supply_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":stochastic"],
    deps = [
        "//metamodel",
        "//solver",
    ],
)

# keep: docs/solver-matrix.md cites file:line into these sources, names the
# _test.go files that pin the behaviour, and points at testdata/ for the
# portable goldens; //docs:docs_test resolves every one of those references,
# so they all have to reach its runfiles.
filegroup(
    name = "cited_sources",
    srcs = glob([
        "*.go",
        "testdata/**",
    ]),
    visibility = ["//docs:__pkg__"],
)
