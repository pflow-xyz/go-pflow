load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "solver",
    srcs = [
        "equilibrium.go",
        "implicit.go",
        "methods.go",
        "ode.go",
        "tsit5.go",
        "vector.go",
    ],
    importpath = "github.com/pflow-xyz/go-pflow/solver",
    visibility = ["//visibility:public"],
    deps = ["//petri"],
)

go_test(
    name = "solver_test",
    srcs = [
        "colors_test.go",
        "solver_test.go",
        "truncation_test.go",
        "tsit5_test.go",
        "vector_test.go",
    ],
    embed = [":solver"],
    deps = ["//petri"],
)

# keep: docs/solver-matrix.md cites file:line into these sources and
# //docs:docs_test resolves every citation, so they have to reach its runfiles.
filegroup(
    name = "cited_sources",
    srcs = glob(["*.go"]),
    visibility = ["//docs:__pkg__"],
)
