{
  "@context": "https://pflow.xyz/schema",
  "@type": "PetriNet",
  "@id": "z4EBG9j2LEJJjfnMKd5fHJbdApLuTTomntzkb2E8FqszCS4CEm4",
  "@version": "1.1",
  "name": "cafe",
  "description": "The showcase theme: a one-barista caf\u00e9 as a colored Petri net. Four token colors share the pantry (people, beans, milk, cups); every arc weight is a per-color vector with explicit zeros; the pantry has a per-color capacity; restocking is gated by a weighted inhibitor on the bean component; ordering requires the Open sign through a read (test) arc; closing is inhibited while a drink is brewing; and each transition carries a role. Every variation in this directory is a re-telling of this net for one family of tools.",
  "author": {
    "@type": "Person",
    "id": "github:243500",
    "identifier": "https://github.com/stackdump",
    "name": "stackdump"
  },
  "parents": [
    "z4EBG9jDsuUdvVN4bUXRHxoDG3p274FfhcJd8BiruRcE1jLCHi8"
  ],
  "token": [
    "https://pflow.xyz/tokens/red",
    "https://pflow.xyz/tokens/brown",
    "https://pflow.xyz/tokens/white",
    "https://pflow.xyz/tokens/blue"
  ],
