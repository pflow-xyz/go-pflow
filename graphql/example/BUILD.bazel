load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "example_lib",
    srcs = ["main.go"],
    importpath = "github.com/pflow-xyz/go-pflow/graphql/example",
    visibility = ["//visibility:private"],
    deps = [
        "//eventsource",
        "//graphql",
        "//petri",
