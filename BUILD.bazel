load("@bazel_gazelle//:def.bzl", "gazelle")
load("@io_bazel_rules_go//go:def.bzl", "TOOLS_NOGO", "nogo")

# gazelle:prefix github.com/pflow-xyz/go-pflow
gazelle(name = "gazelle")

# Static analysis run as part of every `bazel build` (go vet + x/tools passes).
nogo(
    name = "nogo",
    visibility = ["//visibility:public"],
    deps = TOOLS_NOGO,
)
