load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "eventsource",
    srcs = [
        "aggregate.go",
        "event.go",
        "memory.go",
        "multiappend.go",
        "sqlite.go",
        "store.go",
    ],
    importpath = "github.com/pflow-xyz/go-pflow/eventsource",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_google_uuid//:uuid",
        "@org_modernc_sqlite//:sqlite",
    ],
)

go_test(
    name = "eventsource_test",
    srcs = [
        "aggregate_test.go",
        "multiappend_test.go",
        "store_test.go",
        "subscribe_admin_test.go",
    ],
    embed = [":eventsource"],
)
