load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "zkcompile",
    srcs = [
        "constraint.go",
        "gnark.go",
        "guard.go",
        "invariant.go",
        "merkle.go",
        "pipeline.go",
        "solidity.go",
        "witness.go",
    ],
    importpath = "github.com/pflow-xyz/go-pflow/zkcompile",
    visibility = ["//visibility:public"],
    deps = [
        "//tokenmodel",
