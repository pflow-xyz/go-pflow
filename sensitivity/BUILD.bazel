load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sensitivity",
    srcs = ["sensitivity.go"],
    importpath = "github.com/pflow-xyz/go-pflow/sensitivity",
    visibility = ["//visibility:public"],
    deps = [
        "//petri",
        "//solver",
    ],
)

go_test(
    name = "sensitivity_test",
    srcs = ["sensitivity_test.go"],
    embed = [":sensitivity"],
    deps = [
        "//petri",
        "//solver",
    ],
)
