load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cache",
    srcs = ["cache.go"],
    importpath = "github.com/pflow-xyz/go-pflow/cache",
    visibility = ["//visibility:public"],
    deps = [
        "//petri",
        "//solver",
    ],
)

go_test(
    name = "cache_test",
    srcs = ["cache_test.go"],
    embed = [":cache"],
    deps = [
        "//petri",
        "//solver",
    ],
)
