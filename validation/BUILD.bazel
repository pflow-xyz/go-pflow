load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "validation",
    srcs = [
        "checks.go",
        "reachability.go",
        "types.go",
    ],
    importpath = "github.com/pflow-xyz/go-pflow/validation",
    visibility = ["//visibility:public"],
    deps = [
        "//petri",
        "//reachability",
    ],
)

go_test(
    name = "validation_test",
    srcs = [
        "colors_test.go",
        "validation_test.go",
    ],
    embed = [":validation"],
    deps = ["//petri"],
)
