+	MAC(1*4(R13), Z17, Z25)
+	MAC(2*4(R13), Z18, Z26)
+	MAC(3*4(R13), Z19, Z27)
+	MAC(4*4(R13), Z20, Z28)
+	MAC(5*4(R13), Z21, Z29)
+	MAC(6*4(R13), Z22, Z30)
+	MAC(7*4(R13), Z23, Z31)
+	ADDQ $32, R13
+	DECQ CX       // decrement n
+	JMP  loop_12
