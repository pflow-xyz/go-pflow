+	VPSRLQ    $32, Z16, Z2              \
+	VALIGND.Z $2, Z16, Z16, K1, Z16     \
+	VPADDQ    Z2, Z16, Z16              \
+	VALIGND   $16-in0, Z16, Z16, K2, Z0 \
+	KSHIFTLW  $1, K2, K2                \
