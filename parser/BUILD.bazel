load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "parser",
    srcs = [
        "json.go",
        "model.go",
    ],
    importpath = "github.com/pflow-xyz/go-pflow/parser",
    visibility = ["//visibility:public"],
    deps = [
        "//metamodel",
        "//petri",
    ],
)

go_test(
    name = "parser_test",
    srcs = [
        "fuzz_test.go",
        "json_test.go",
        "model_test.go",
    ],
    embed = [":parser"],
    deps = [
        "//metamodel",
        "//petri",
    ],
)
